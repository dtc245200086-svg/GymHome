<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>📅 Buổi Tập Hôm Nay - PT Gym Home</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .sessions-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: #2a2a2a;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    }
    .sessions-table th, .sessions-table td {
      padding: 15px;
      text-align: left;
      border-bottom: 1px solid #444;
    }
    .sessions-table th {
      background: #ff6b35;
      color: white;
      font-weight: bold;
    }
    .sessions-table tr:hover {
      background: #3a3a3a;
    }
    .btn-confirm {
      background: #4caf50;
      color: white;
      padding: 10px 18px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      text-decoration: none;
    }
    .btn-confirm:hover {
      background: #45a049;
    }
    .btn-reject {
      background: #f44336;
      color: white;
      padding: 10px 18px;
      border: none;
      border-radius: 5px;
      cursor: pointer;
    }
    .btn-reject:hover {
      background: #d32f2f;
    }
    .status-confirmed {
      color: #4caf50;
      font-weight: bold;
    }
    .btn-secondary {
      background: #2196F3;
      color: white;
      padding: 10px 18px;
      border-radius: 5px;
      text-decoration: none;
      display: inline-block;
      margin-top: 20px;
    }
    .btn-secondary:hover {
      background: #1976D2;
    }
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0, 0, 0, 0.6);
    }
    .modal-content {
      background-color: #1e1e1e;
      margin: 10% auto;
      padding: 20px;
      border: 1px solid #444;
      width: 90%;
      max-width: 500px;
      border-radius: 12px;
      color: #fff;
    }
    .modal-close {
      color: #aaa;
      float: right;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
    }
    .modal-close:hover,
    .modal-close:focus {
      color: #fff;
    }
    .modal-header {
      font-size: 18px;
      margin-bottom: 12px;
      font-weight: bold;
    }
    .modal-buttons {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 12px;
    }
    .btn-cancel,
    .btn-submit-reject {
      border: none;
      border-radius: 6px;
      padding: 10px 18px;
      cursor: pointer;
      font-weight: bold;
    }
    .btn-cancel {
      background: #555;
      color: #fff;
    }
    .btn-submit-reject {
      background: #ff6b35;
      color: #fff;
    }
    .btn-submit-reject:hover {
      background: #e65119;
    }
  </style>
</head>
<body>
  <header>
    <h1>📅 Buổi Tập Hôm Nay</h1>
    <p>Danh sách buổi tập đã xác nhận cần xác nhận thực tế</p>
  </header>
  <div class="container">
    <% if (sessions.length === 0) { %>
      <p style="color: #ccc; font-style: italic; text-align: center;">Không có buổi tập nào cần xác nhận hôm nay.</p>
    <% } else { %>
      <table class="sessions-table">
        <thead>
          <tr>
            <th>Hội Viên</th>
            <th>Số Điện Thoại</th>
            <th>Ngày</th>
            <th>Trạng Thái</th>
            <th>Hành Động</th>
          </tr>
        </thead>
        <tbody>
          <% sessions.forEach(session => { %>
            <tr>
              <td><%= session.member_name %></td>
              <td><%= session.member_phone %></td>
              <td><%= session.date %></td>
              <td class="status-confirmed">✅ Đã xác nhận booking</td>
              <td>
                <form action="/pt/complete/<%= session.id %>" method="POST" style="display:inline; margin-right: 8px;">
                  <button type="submit" class="btn-confirm">Xác Nhận</button>
                </form>
                <button type="button" class="btn-reject" onclick="openRejectModal(<%= session.id %>, '<%= session.member_name %>', '<%= session.date %>')">Từ Chối</button>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>

    <a href="/pt/dashboard" class="btn-secondary">⬅️ Quay về Dashboard</a>
  </div>

  <!-- Reject Modal -->
  <div id="rejectModal" class="modal">
    <div class="modal-content">
      <span class="modal-close" onclick="closeRejectModal()">&times;</span>
      <div class="modal-header">❌ Từ chối buổi tập hôm nay</div>
      <form id="rejectForm" method="POST">
        <p style="color: #ccc;">Hội Viên: <span id="modalMemberName" style="color: #ff6b35;"></span></p>
        <p style="color: #ccc;">Ngày: <span id="modalSessionDate" style="color: #ff6b35;"></span></p>
        <label for="rejection_reason" style="color: #fff; display:block; margin-bottom: 8px;">Lý do từ chối (bắt buộc):</label>
        <textarea id="rejection_reason" name="rejection_reason" required placeholder="Ví dụ: Tôi bận, đã có lịch khác, hoặc cần chuyển buổi" style="width:100%; min-height:100px; margin-bottom:12px; padding:10px; border-radius:6px; border:1px solid #444; background:#1b1b1b; color:#fff;"></textarea>
        <div class="modal-buttons">
          <button type="button" class="btn-cancel" onclick="closeRejectModal()">Hủy</button>
          <button type="submit" class="btn-submit-reject">Gửi Lý Do</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openRejectModal(sessionId, memberName, sessionDate) {
      document.getElementById('modalMemberName').textContent = memberName;
      document.getElementById('modalSessionDate').textContent = sessionDate;
      document.getElementById('rejection_reason').value = '';
      document.getElementById('rejectForm').action = '/pt/reject-today/' + sessionId;
      document.getElementById('rejectModal').style.display = 'block';
    }

    function closeRejectModal() {
      document.getElementById('rejectModal').style.display = 'none';
    }

    window.onclick = function(event) {
      const modal = document.getElementById('rejectModal');
      if (event.target === modal) {
        modal.style.display = 'none';
      }
    }
  </script>
</body>
</html>
